# Co emits and documents CO_* names. Existing installations may still supply
# the former prefix as a fallback; CO_* wins whenever both are present.
# Pick openai, anthropic, openai-compatible, codex-cli, claude-code-cli, mock, or leave auto.
CO_ENV=development
CO_PROVIDER=auto
# Optional per-role API request ceiling. Pricing is never guessed because it
# changes over time: set all three values for a role or none. The runtime uses
# a conservative input bound and the configured max output before every call.
# CO_FOREGROUND_INPUT_USD_PER_MILLION_TOKENS=2.50
# CO_FOREGROUND_OUTPUT_USD_PER_MILLION_TOKENS=10.00
# CO_FOREGROUND_MAX_REQUEST_USD=0.10
# The same suffixes are available for DELIBERATION, BACKGROUND, and CRITIC.
# Subscription-backed Codex/Claude CLI routes use token budgets instead; they
# reject dollar ceilings because the harness cannot truthfully price them.
# Local subscription-backed CLI providers are intentionally not auto-selected.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Use a unique tenant per person. `co onboard` creates this scope for you.
CO_TENANT=default
CO_DISTRIBUTION=co
# Direct iMessage identities allowed to exercise this tenant's member authority.
# A selected profile owns this list and never inherits it from the environment.
# CO_MEMBER_PEERS=+15551234567,+15557654321
# Optional portable JSON profile created by `co onboard <profile-id>`
# CO_PROFILE=/absolute/path/to/profile.json
# Optional custom distribution JSON (must match CO_DISTRIBUTION)
# CO_DISTRIBUTION_CONFIG=/absolute/path/to/distribution.json
# CO_HOME=/absolute/path/to/.co
CO_WORKSPACE_ROOTS=/absolute/path/to/workspace
# CO_PLUGIN_ROOTS=/absolute/path/to/plugins
# CO_PLUGINS=calendar,project-tools
TZ=America/Los_Angeles
# CO_LOCATION=city-level location supplied by an authorized source

# Required before binding beyond loopback; required everywhere in production.
# Production tokens must be at least 32 bytes. Every supported secret also
# accepts a read-only NAME_FILE=/run/secrets/... alternative.
# CO_SERVER_TOKEN=
# CO_SERVER_TOKEN_FILE=/run/secrets/co_server_token

CO_HTTP_BODY_LIMIT_BYTES=2000000
CO_HTTP_REQUEST_TIMEOUT_MS=300000
CO_HTTP_HEADERS_TIMEOUT_MS=15000
CO_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
CO_HTTP_MAX_CONNECTIONS=1000
CO_RATE_LIMIT_WINDOW_MS=60000
CO_RATE_LIMIT_MAX_REQUESTS=120
CO_SHUTDOWN_GRACE_MS=30000
# CO_LOG_LEVEL=info

# Standing authority. external-write and destructive are intentionally absent.
CO_AUTO_APPROVE=read,local-write
CO_MAX_DAILY_INTERVENTIONS=3
CO_INTERVENTION_COOLDOWN_MINUTES=180
CO_QUIET_HOURS_START=22
CO_QUIET_HOURS_END=8

# Process execution is disabled by default. Production rejects local; Docker
# images must be digest-pinned. Profile execution settings override these.
CO_EXECUTION_BACKEND=none
# CO_EXECUTION_ALLOWED_COMMANDS=node,npm
CO_EXECUTION_TIMEOUT_MS=120000
CO_EXECUTION_MAX_OUTPUT_BYTES=1000000
CO_EXECUTION_WORKSPACE_MODE=read-only
# CO_EXECUTION_DOCKER_IMAGE=node:22.19.0-bookworm-slim@sha256:...

# CO_MCP_CONFIG=/absolute/path/to/mcp.json
# CO_CLI_TIMEOUT_MS=300000
# CODEX_CLI_PATH=codex
# CLAUDE_CODE_CLI_PATH=claude

# YouTube/media eyes. yt-dlp supplies metadata and exact captions; Gemini adds
# native audio+visual watching and captionless transcription off the reply path.
CO_MEDIA_ANALYZER=auto
CO_FOREGROUND_MEDIA=gemini
# GEMINI_API_KEY=
# CO_GEMINI_API_KEY_ENV=GEMINI_API_KEY
CO_GEMINI_MODEL=gemini-3.5-flash-lite
CO_YOUTUBE_DEFER_SECONDS=720
CO_YOUTUBE_MAX_WINDOWS=8
CO_MEDIA_MAX_RESOURCE_BYTES=15000000

# Optional browser credential broker. The key must decode to exactly 32 bytes.
# Generate it with: openssl rand -base64 32
# CO_BROWSER_CREDENTIAL_KEY_FILE=/run/secrets/co_browser_credential_key
# CO_BROWSER_WORKSPACE_ID=member-cell
# CO_BROWSER_CDP_URL=http://127.0.0.1:9222
# YT_DLP_PATH=yt-dlp

# SENDBLUE_API_KEY_ID=
# SENDBLUE_API_SECRET_KEY=
# Existing Sendblue deployments may keep the aliases SENDBLUE_API_KEY and
# SENDBLUE_SECRET_KEY; the explicit *_ID/*_SECRET_KEY names win when both exist.
# SENDBLUE_FROM_NUMBER=
# SENDBLUE_WEBHOOK_SECRET=

# Linq is an interchangeable private iMessage rail. Secrets also accept *_FILE.
# LINQ_API_KEY=
# LINQ_API_KEY_FILE=/run/secrets/linq_api_key
# LINQ_FROM_NUMBER=
# LINQ_WEBHOOK_SECRET=
# LINQ_WEBHOOK_SECRET_FILE=/run/secrets/linq_webhook_secret
# LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3

# Verified email identity and transactional delivery. The OTP secret and
# provider key also accept *_FILE. Generate a distinct OTP secret with:
#   openssl rand -hex 32
# CO_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_API_KEY_FILE=/run/secrets/resend_api_key
# CO_EMAIL_FROM=Co <verify@example.com>
# CO_EMAIL_OTP_SECRET=
# CO_EMAIL_OTP_SECRET_FILE=/run/secrets/co_email_otp_secret
# CO_EMAIL_BASE_URL=https://api.resend.com
# CO_EMAIL_VERIFICATION_TTL_MINUTES=10
# CO_EMAIL_RESEND_COOLDOWN_SECONDS=60
# CO_EMAIL_MAX_VERIFICATION_ATTEMPTS=5
# CO_EMAIL_MAX_REQUESTS_PER_HOUR=5
# CO_EMAIL_MAX_REQUESTS_PER_DAY=10
