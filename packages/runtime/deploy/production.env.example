# This file contains non-secret deployment configuration. Put secret values in
# deploy/secrets/; Docker mounts them read-only under /run/secrets.
CO_PROFILE=/data/profiles/account.json
CO_DB=/data/runtime.sqlite
CO_PROVIDER=openai
CO_MODEL=gpt-5.6-terra
CO_AUTO_APPROVE=read,local-write
CO_LOG_LEVEL=info
CO_EXECUTION_BACKEND=none

CO_HTTP_BODY_LIMIT_BYTES=2000000
CO_HTTP_REQUEST_TIMEOUT_MS=300000
CO_HTTP_HEADERS_TIMEOUT_MS=15000
CO_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
CO_HTTP_MAX_CONNECTIONS=1000
CO_RATE_LIMIT_WINDOW_MS=60000
CO_RATE_LIMIT_MAX_REQUESTS=120
CO_SHUTDOWN_GRACE_MS=30000

CO_MEDIA_ANALYZER=none
CO_FOREGROUND_MEDIA=gemini
# To enable native video analysis, mount a gemini_api_key secret, set
# GEMINI_API_KEY_FILE=/run/secrets/gemini_api_key, and use analyzer=auto.

# Optional Sendblue connector. Prefer the corresponding *_FILE settings for
# secrets and add those files to the Compose secrets list.
# SENDBLUE_FROM_NUMBER=+1...
# SENDBLUE_API_KEY_ID_FILE=/run/secrets/sendblue_key_id
# SENDBLUE_API_SECRET_KEY_FILE=/run/secrets/sendblue_secret_key
# SENDBLUE_WEBHOOK_SECRET_FILE=/run/secrets/sendblue_webhook_secret

# Optional verified email identity through Resend. Add the referenced secret
# files to deploy/docker-compose.yml before enabling these settings.
# CO_EMAIL_PROVIDER=resend
# CO_EMAIL_FROM=Co <verify@example.com>
# RESEND_API_KEY_FILE=/run/secrets/resend_api_key
# CO_EMAIL_OTP_SECRET_FILE=/run/secrets/co_email_otp_secret
