# model gateway (env-selected models, goal.md §22.1)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_FAST=gpt-5-mini
MODEL_REASONING=gpt-5
MODEL_VISION=gpt-5
MODEL_SEARCH=gpt-5-mini
MODEL_EMBEDDING=text-embedding-3-small
MODEL_TRANSCRIPTION=gpt-4o-transcribe
MODEL_MODERATION=omni-moderation-latest
CO_AWARENESS_PROVIDER=
FEATURE_AMBIENT_AWARENESS=false
FEATURE_GMAIL_AWARENESS=false
GOOGLE_CONNECTOR_UID=          # Vercel Connect Google OAuth connector UID
GMAIL_PUBSUB_TOPIC=            # projects/<gcp-project>/topics/<topic>
GMAIL_PUSH_AUDIENCE=           # exact HTTPS /api/webhooks/gmail URL
GMAIL_PUSH_SERVICE_ACCOUNT=    # authenticated Pub/Sub push identity
# NOTE: verify current model names against provider docs at build time (goal.md §0.3) — these are placeholders.
# supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # workers only, never shipped to clients
# one verified phone joins the app session and iMessage transport to the same member
FEATURE_PHONE_LINKING=false
CO_PHONE_MAPPING_PEPPER=     # secret, >=32 chars; must match the transport receiver
CO_PHONE_LINK_CHALLENGE_SECRET= # secret, >=32 chars
CO_MESSAGE_HANDOFF_NUMBER=   # E.164 number opened by the app's Kyo action
# iMessage carrier. Provider choice changes delivery, never member identity or retained history.
CO_RAIL=sendblue             # sendblue | linq
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=        # E.164; sends the six-digit verification text
LINQ_API_KEY=
LINQ_FROM_NUMBER=            # E.164; stable Co line used to create and resume direct chats
LINQ_WEBHOOK_SECRET=         # whsec_...; Standard Webhooks signature key
WEBHOOK_TOKEN=               # unguessable path segment used by the live router
# optional asynchronous mirror from the live rail into canonical Postgres
FEATURE_DUAL_WRITE=false
CO_INGEST_URL=               # prefer https://<host>/api/ingest/transport
CO_INGEST_TOKEN=             # shared secret, >=32 chars
# trigger.dev
TRIGGER_SECRET_KEY=
# apns
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
